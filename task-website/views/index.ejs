<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Groups</title>
</head>
<body>
  <h1>Groups</h1>
  <ul>
    <% groups.forEach(g => { %>
      <li><a href="/group/<%= g.id %>/tasks"><%= g.name %></a></li>
    <% }); %>
  </ul>
  <h2>Add Group</h2>
  <form method="post" action="/groups">
    <input type="text" name="name" placeholder="Group name" required>
    <button type="submit">Add</button>
  </form>
</body>
</html>
